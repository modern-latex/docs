{
  "name": "mlatex",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@11.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modern-latex/docs.git"
  },
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "build": "turbo build",
    "dev": "turbo dev",
    "clean": "turbo clean && rm -rf node_modules && pnpm -r exec rm -rf node_modules .turbo dist",
    "format": "biome format . --write",
    "format:md": "pnpm --filter docs format:md",
    "format:check": "pnpm --filter docs format:check",
    "lint": "biome check . --error-on-warnings",
    "lint:dependencies": "knip && knip --production",
    "lint:fix": "biome check . --fix --unsafe",
    "lint:spell": "cspell . --color",
    "lint:types": "turbo lint:types",
    "lint:packages": "turbo lint:package",
    "changeset": "changeset",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:release": "turbo clean && turbo build && changeset publish",
    "test": "turbo test --continue",
    "coverage": "turbo coverage",
    "postcoverage": "pnpm coverage:collect && pnpm coverage:merge && pnpm coverage:report",
    "coverage:merge": "nyc merge coverage/raw coverage/merged/merged-coverage.json",
    "coverage:collect": "rm -rf coverage && mkdir -p coverage/raw && for f in $(find apps/docs -name coverage-final.json); do pkg=$(basename \"$(dirname \"$(dirname \"$f\")\")\"); cp \"$f\" \"./coverage/raw/$pkg-coverage-final.json\"; done",
    "coverage:report": "nyc --temp-dir=./coverage/raw report --reporter=lcov --reporter text-summary",
    "coverage:open": "open coverage/lcov-report/index.html",
    "e2e:smoke": "turbo e2e:smoke",
    "e2e:integration": "turbo e2e:integration",
    "typecheck": "tsc --build",
    "typecheck:dist": "tsc --project tsconfig.dist-check.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^25.9.9",
    "@vitest/coverage-istanbul": "catalog:vitest",
    "@vitest/ui": "catalog:vitest",
    "cspell": "^10.4.0",
    "knip": "^6.41.0",
    "lefthook": "^2.1.9",
    "nyc": "^18.0.0",
    "publint": "^0.3.25",
    "turbo": "^2.11.8",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
